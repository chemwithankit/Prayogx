{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrayogX 2.0 glossary",
  "type": "object",
  "required": [
    "terms"
  ],
  "properties": {
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "term"
        ],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "voice": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}