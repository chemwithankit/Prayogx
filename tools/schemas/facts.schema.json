{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrayogX 2.0 facts",
  "type": "object",
  "required": [
    "conceptId",
    "facts"
  ],
  "properties": {
    "conceptId": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "sources",
          "checkedBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F\\d+$"
          },
          "statement": {
            "type": "string",
            "minLength": 5
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "checkedBy": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}