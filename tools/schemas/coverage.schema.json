{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrayogX 2.0 coverage",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item",
          "kind",
          "where"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "subtopic",
              "preparation",
              "reaction",
              "exception",
              "exam-point",
              "misconception"
            ]
          },
          "where": {
            "enum": [
              "video",
              "notes-only"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}