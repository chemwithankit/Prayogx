# PrayogX - Instagram Reel publishing (tools/instagram_publish.py). Copy to .env (git-ignored), fill in, then:
#   chmod 600 .env
# Never commit .env, and never paste a token into a reel story, caption, log or chat.
# Setup: docs/INSTAGRAM_PUBLISHING.md

# The Instagram professional (Business or Creator) account's numeric ID
IG_USER_ID=
# A long-lived user access token with instagram_business_basic + instagram_business_content_publish
# (Instagram Login), or instagram_basic + instagram_content_publish + pages_read_engagement (Facebook Login)
IG_ACCESS_TOKEN=
# graph.instagram.com for Instagram Login; graph.facebook.com for Facebook Login
IG_API_HOST=graph.instagram.com
IG_API_VERSION=v25.0

# Optional: an https:// folder where <ID>/thumbnail.jpg is publicly hosted, used as the Reel cover (cover_url).
# Empty: the cover is a frame of the video (thumb_offset). The video itself is uploaded directly (resumable upload).
PRAYOGX_MEDIA_BASE_URL=
IG_THUMB_OFFSET_MS=0
IG_SHARE_TO_FEED=true
IG_POLL_INTERVAL_S=5
IG_POLL_TIMEOUT_S=600
