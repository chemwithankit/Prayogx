# PrayogX - Instagram Reel publishing (tools/instagram_publish.py). Copy to .env (git-ignored), fill in, then:
#   chmod 600 .env
# Never commit .env, and never paste a token into a reel story, caption, log or chat.
# Setup: docs/INSTAGRAM_PUBLISHING.md

# The Instagram professional (Business or Creator) account's numeric ID
IG_USER_ID=
# A long-lived user access token with instagram_business_basic + instagram_business_content_publish
# (Instagram Login), or instagram_basic + instagram_content_publish + pages_read_engagement (Facebook Login)
IG_ACCESS_TOKEN=
# graph.instagram.com for Instagram Login; graph.facebook.com for Facebook Login
IG_API_HOST=graph.instagram.com
IG_API_VERSION=v25.0

# Instagram Login (graph.instagram.com): REQUIRED - the public https:// folder where you upload <ID>/reel.mp4 (and
# optionally <ID>/thumbnail.jpg, the cover). Meta downloads the video from there; the preflight checks it is the
# approved file. Facebook Login (graph.facebook.com) uploads the video directly, so this is only for the cover.
PRAYOGX_MEDIA_BASE_URL=
# Optional override: video_url (default for Instagram Login) or resumable (default for Facebook Login)
IG_UPLOAD_MODE=
# After a VERIFIED publish: delete <ID>/reel.mp4 + thumbnail.jpg from the media repo (owner/repo; read from a
# https://<owner>.github.io/<repo> base URL when empty) and commit + push tools/reel-maker/publications.json alone.
PRAYOGX_MEDIA_REPO=
PRAYOGX_AUTO_REMOVE_HOSTED=true
PRAYOGX_AUTO_RECORD=true
IG_THUMB_OFFSET_MS=0
IG_SHARE_TO_FEED=true
IG_POLL_INTERVAL_S=5
IG_POLL_TIMEOUT_S=600

# ---------------------------------------------------------------- YouTube Shorts (tools/youtube_publish.py)
# docs/YOUTUBE_SHORTS_PUBLISHING.md. A Desktop-app OAuth client from Google Cloud; sign in once with:
#   python3 tools/youtube_publish.py auth
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# the target channel (UC...); auth prints it
YT_CHANNEL_ID=
# the refresh token's file: outside the repository, mode 600 (default ~/.config/prayogx/youtube-token.json)
YT_TOKEN_FILE=
YT_DEFAULT_PRIVACY=private
# optional: 27 = Education; a playlist to add each upload to
YT_CATEGORY_ID=
YT_PLAYLIST_ID=
# true only after Google has approved the API project's audit (unaudited projects can upload private videos only)
YT_PROJECT_AUDITED=false
YT_MADE_FOR_KIDS=false
YT_NOTIFY_SUBSCRIBERS=false
YT_SET_THUMBNAIL=true
