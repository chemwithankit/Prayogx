# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# editors
.vscode/
.idea/
*.swp

# python
__pycache__/
*.pyc

# scratch — anything you drop here is kept off GitHub
_scratch/
_to_delete/

# stray browser downloads of a simulation page (index-1.html, index (1).html …)
index-[0-9]*.html
index*(*).html

# source exam PDFs - kept locally, never committed or published
papers/

# staged CI workflow awaiting manual install (see README)
*.proposed.yml

# mobile shell: dependencies and native build output are generated, never committed
app/node_modules/
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/local.properties
app/android/app/release/
app/ios/App/Pods/
app/ios/App/build/
app/ios/App/App/public/
app/www/dist/
*.keystore
*.jks

# Claude session outputs (audit PDFs, screenshots) - kept locally, never committed.
# A PDF in the repo trips the deploy guard and blocks every GitHub Pages release.
Claude outputs/

# local test toolchain (see tests/README.md) - installed per machine, never committed
tests/node_modules/
tests/.venv/
# app-shell copies some browser suites leave in tests/ between runs
tests/adstest*/
tests/apptest*/
tests/appwww*/

# simulation-factory batch state (tools/auto_sim.py) - local only, never committed
.tmp/

# reel maker: generated reels and its compiled encoder (tools/reel-maker/README.md)
tools/reel-maker/output/
tools/reel-maker/.cache/
